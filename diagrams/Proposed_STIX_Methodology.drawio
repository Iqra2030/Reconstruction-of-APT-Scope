<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="page1" name="01 Methodology overview"><mxGraphModel dx="1500" dy="1170" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="STIX-enriched APT attribution: proposed methodology" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=34;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="15" width="1400" height="65" /></mxCell><mxCell id="subtitle" value="Research question: do explicit relationships improve attribution beyond the same entities?" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#536878;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="80" width="1400" height="55" /></mxCell><mxCell id="phase1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF4FC;strokeColor=none;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="145" width="1360" height="280" /></mxCell><mxCell id="phase1t" value="A  PREPARE AND PARTITION THE CORPUS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#2455A4;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="148" width="1340" height="45" /></mxCell><mxCell id="phase2" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EBF8F4;strokeColor=none;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="460" width="1360" height="280" /></mxCell><mxCell id="phase2t" value="B  REPRESENT EVIDENCE AND DEFINE THE COMPARISON" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#087E83;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="463" width="1340" height="45" /></mxCell><mxCell id="phase3" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F0FB;strokeColor=none;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="775" width="1360" height="280" /></mxCell><mxCell id="phase3t" value="C  TRAIN, EVALUATE AND EXPLAIN" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#7345AB;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="778" width="1340" height="45" /></mxCell><mxCell id="s1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="200" width="400" height="205" /></mxCell><mxCell id="s1t" value="01  Report acquisition" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#2455A4;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="203" width="392" height="56" /></mxCell><mxCell id="s1b" value="apt-cti-reports and APTnotes&#10;Versioned sources and file hashes&#10;One eligible report = one sample" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="263" width="392" height="140" /></mxCell><mxCell id="s2" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="520" y="200" width="400" height="205" /></mxCell><mxCell id="s2t" value="02  Eligibility and labels" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#2455A4;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="524" y="203" width="392" height="56" /></mxCell><mxCell id="s2b" value="Verify attribution passages&#10;Conservative alias mapping&#10;Remove duplicates and ambiguity" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="524" y="263" width="392" height="140" /></mxCell><mxCell id="s3" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="200" width="400" height="205" /></mxCell><mxCell id="s3t" value="03  Campaign partitions" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#2455A4;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="979" y="203" width="392" height="56" /></mxCell><mxCell id="s3b" value="Fix development / test groups&#10;Keep related reports together&#10;Separate labels from evidence" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="979" y="263" width="392" height="140" /></mxCell><mxCell id="s4" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="515" width="400" height="205" /></mxCell><mxCell id="s4t" value="04  Evidence extraction" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#087E83;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="979" y="518" width="392" height="56" /></mxCell><mxCell id="s4b" value="Mask actor identifiers&#10;Extract entities and explicit links&#10;Retain passages; flag uncertainty" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="979" y="578" width="392" height="140" /></mxCell><mxCell id="s5" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="520" y="515" width="400" height="205" /></mxCell><mxCell id="s5t" value="05  STIX and report graphs" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#087E83;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="524" y="518" width="392" height="56" /></mxCell><mxCell id="s5b" value="Validate STIX 2.1 records&#10;Keep supported evidence edges&#10;Exclude actors / attribution edges" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="524" y="578" width="392" height="140" /></mxCell><mxCell id="s6" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="515" width="400" height="205" /></mxCell><mxCell id="s6t" value="06  Matched feature sets" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#087E83;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="518" width="392" height="56" /></mxCell><mxCell id="s6b" value="E1: entities and techniques&#10;E2: E1 + relational statistics&#10;Fit learned processing on training" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="578" width="392" height="140" /></mxCell><mxCell id="s7" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="830" width="400" height="205" /></mxCell><mxCell id="s7t" value="07  Training and selection" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#7345AB;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="833" width="392" height="56" /></mxCell><mxCell id="s7b" value="LR, SVM, RF and XGBoost&#10;Same folds and search budgets&#10;Select by development macro F1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="893" width="392" height="140" /></mxCell><mxCell id="s8" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="520" y="830" width="400" height="205" /></mxCell><mxCell id="s8t" value="08  Locked evaluation" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#7345AB;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="524" y="833" width="392" height="56" /></mxCell><mxCell id="s8b" value="Held-out macro F1 and class scores&#10;Matched E1–E2 comparison&#10;Ablations and extraction audit" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="524" y="893" width="392" height="140" /></mxCell><mxCell id="s9" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#142C42;fontSize=22;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="830" width="400" height="205" /></mxCell><mxCell id="s9t" value="09  Explainable output" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#7345AB;fontSize=24;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="979" y="833" width="392" height="56" /></mxCell><mxCell id="s9b" value="Predicted known APT group&#10;SHAP feature contributions&#10;Supporting records and passages" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="979" y="893" width="392" height="140" /></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#536878;dashed=0;exitX=1.0;exitY=0.4975609756097561;exitDx=0;exitDy=0;entryX=0.0;entryY=0.4975609756097561;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#536878;dashed=0;exitX=1.0;exitY=0.4975609756097561;exitDx=0;exitDy=0;entryX=0.0;entryY=0.4975609756097561;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#536878;dashed=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#536878;dashed=0;exitX=0.0;exitY=0.4975609756097561;exitDx=0;exitDy=0;entryX=1.0;entryY=0.4975609756097561;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#536878;dashed=0;exitX=0.0;exitY=0.4975609756097561;exitDx=0;exitDy=0;entryX=1.0;entryY=0.4975609756097561;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#536878;dashed=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.4975609756097561;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="265" y="750" /><mxPoint x="20" y="750" /><mxPoint x="20" y="932" /></Array></mxGeometry></mxCell><mxCell id="e78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#536878;dashed=0;exitX=1.0;exitY=0.4975609756097561;exitDx=0;exitDy=0;entryX=0.0;entryY=0.4975609756097561;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#536878;dashed=0;exitX=1.0;exitY=0.4975609756097561;exitDx=0;exitDy=0;entryX=0.0;entryY=0.4975609756097561;entryDx=0;entryDy=0;" edge="1" parent="1" source="s8" target="s9"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="provenance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7345AB;dashed=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.8536585365853658;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s9"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="720" y="746" /><mxPoint x="1440" y="746" /><mxPoint x="1440" y="1005" /></Array></mxGeometry></mxCell><mxCell id="provlabel" value="Provenance index: records and source passages" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#7345AB;fontSize=17;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="845" y="730" width="480" height="42" /></mxCell><mxCell id="safeguard" value="Controls: freeze extraction before test processing. Labels remain outside predictive graphs.&#10;Planned experiment. Known-group classification only. Improvement is a hypothesis." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#536878;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1070" width="1400" height="80" /></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="02 Experimental protocol"><mxGraphModel dx="1500" dy="1580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1580" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Experimental protocol and feature definitions" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=34;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1410" height="70" /></mxCell><mxCell id="sub" value="Companion to the methodology diagram · revised from Iteration 3" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#536878;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="90" width="1410" height="65" /></mxCell><mxCell id="h0" value="01  Corpus and target" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EEF4FC;strokeColor=none;fontColor=#2455A4;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="170" width="1400" height="45" /></mxCell><mxCell id="b0" value="Initially select three known groups, subject to sufficient independent campaign coverage.&#10;Verify each report label against an attribution passage. Exclude ambiguous or inseparable multi-actor reports.&#10;Track source revision, document hash, publisher, date, label evidence, campaign ID and exclusion reason." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="215" width="1400" height="102" /></mxCell><mxCell id="h1" value="02  Partition and leakage controls" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EEF4FC;strokeColor=none;fontColor=#2455A4;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="329" width="1400" height="45" /></mxCell><mxCell id="b1" value="Aim for about 20% of campaign groups as a held-out test set, with all selected classes represented.&#10;Use three-fold grouped development validation if campaign coverage permits. Otherwise report grouped CV only.&#10;Freeze extraction before test processing. Fit vocabulary, scaling, imputation and feature selection inside folds.&#10;Mask actor names and aliases. Exclude actor nodes, attribution edges and administrative membership links." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="374" width="1400" height="131" /></mxCell><mxCell id="h2" value="03  Non-relational feature set E1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EBF8F4;strokeColor=none;fontColor=#087E83;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="517" width="1400" height="45" /></mxCell><mxCell id="b2" value="Behaviour: technique presence, distinct technique counts and supported tactic coverage.&#10;Software: malware/tool presence and distinct counts. Infrastructure: observable counts and types.&#10;Vulnerabilities: CVE count and presence of recovered CVE evidence. Missing evidence is not confirmed absence.&#10;Exact domain, IP and hash identities are excluded from the primary identity vocabulary." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="562" width="1400" height="131" /></mxCell><mxCell id="h3" value="04  Relational extension E2" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EBF8F4;strokeColor=none;fontColor=#087E83;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="705" width="1400" height="45" /></mxCell><mxCell id="b3" value="Use all E1 features plus typed-edge counts, mean degree and connected-component counts.&#10;Keep only source-supported links. Co-occurrence alone does not establish an operational relationship.&#10;Use a documented simple undirected projection for degree/components; preserve type/direction for typed counts.&#10;Deduplicate edges and define empty-graph handling. Optional reuse statistics use training campaigns only." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="750" width="1400" height="131" /></mxCell><mxCell id="h4" value="05  Model comparison" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F0FB;strokeColor=none;fontColor=#7345AB;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="893" width="1400" height="45" /></mxCell><mxCell id="b4" value="Compare LR, SVM, RF and XGBoost with identical partitions and comparable tuning budgets.&#10;Cap the initial search at 12 configurations per model per feature arm. Select by mean development macro F1.&#10;Use training-only class/sample weights as appropriate. Include a majority-class baseline.&#10;Predeclare ablations, including relational-family removal and software-identity removal, before opening test results." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="938" width="1400" height="131" /></mxCell><mxCell id="h5" value="06  Evaluation and explanation" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F0FB;strokeColor=none;fontColor=#7345AB;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1081" width="1400" height="45" /></mxCell><mxCell id="b5" value="Primary metric: macro F1. Also report per-class precision/recall/F1, balanced accuracy and confusion matrices.&#10;Report fold mean/variation. Any holdout uncertainty resampling must preserve campaign grouping.&#10;Audit entity/relation precision, recall and F1 on a separately annotated subset after extraction is frozen.&#10;For SHAP, use training/development background data as appropriate and trace contributions to source records.&#10;Audit whether retrieved records reproduce feature values and identify the correct passages." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1126" width="1400" height="160" /></mxCell><mxCell id="h6" value="07  Outputs and interpretation" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F0FB;strokeColor=none;fontColor=#7345AB;fontSize=23;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1298" width="1400" height="45" /></mxCell><mxCell id="b6" value="Save versioned STIX bundles, provenance index, split manifest, feature definitions, model settings and predictions.&#10;Record feature generation, training, prediction and explanation time separately.&#10;Compare E1 and E2 within this experiment. Do not compare report macro F1 directly with APT-Scope link AUCPR.&#10;This is a proposed extension. The completed APT-Scope reconstruction provides the foundation, not its results." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#142C42;fontSize=21;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1343" width="1400" height="131" /></mxCell><mxCell id="source" value="Basis: submitted Iteration 3 proposal, Sections III–V. Revised ordering makes partitioning and evaluation explicit." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#536878;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1489" width="1400" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>